{
  "name": "pi-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "description": "Pi extension that ports OpenCode-style MCP server support.",
  "keywords": [
    "pi-package",
    "pi-extension",
    "mcp",
    "opencode"
  ],
  "scripts": {
    "check": "tsc --noEmit && tsx test/jsdoc-check.ts",
    "clean": "rm -rf dist",
    "mcp-fixture": "node test/local-mcp-server.mjs",
    "regression": "tsx test/regression.ts",
    "smoke": "tsx test/smoke.ts",
    "smoke:oauth": "tsx test/oauth-smoke.ts",
    "test:unit": "node --import tsx --test \"test/**/*.test.ts\"",
    "test:conformance": "bash conformance/run.sh",
    "test": "npm run check && npm run test:unit && npm run smoke && npm run smoke:oauth && npm run regression && npm run test:conformance"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/core": "2.0.0",
    "jsonc-parser": "^3.3.1",
    "open": "^10.2.0",
    "proper-lockfile": "^4.1.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.79.10",
    "@modelcontextprotocol/conformance": "0.1.16",
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@types/node": "^24.10.1",
    "@types/proper-lockfile": "^4.1.4",
    "tsx": "^4.20.6",
    "typebox": "^1.0.65",
    "typescript": "^5.9.3",
    "zod": "^4.2.0"
  }
}
